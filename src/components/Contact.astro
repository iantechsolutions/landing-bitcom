---
import { ChevronRight } from "lucide-astro";
import SectionTitle from "./SectionTitle.astro";
import FieldFrom from "./ui/FieldFrom.astro";
---

<section class="flex flex-col items-center mt-20" id="contact">
  <SectionTitle
    title="CONTÁCTENOS"
    subtitle="Seleccione el medio de contacto preferido y conversemos"
  />
  <div class="2xl:max-w-7xl mx-auto md:px-10">
    <form
      id="form"
      class="grid grid-cols2 md:grid-cols-2 md:gap-x-8"
      method="post"
      action="/api/send-email"
      enctype="application/x-www-form-urlencoded"
    >
      <FieldFrom
        label="Nombre y apellido"
        id="name"
        placeholder="Ingrese su nombre completo"
      />
      <FieldFrom
        label="CUIL/CUIT"
        id="cuil"
        placeholder="Ingrese su CUIL/CUIT"
      />
      <FieldFrom label="Mail" id="email" placeholder="Ingrese su mail" />
      <FieldFrom
        label="Empresa"
        id="company"
        placeholder="Ingrese el nombre de su empresa"
      />
      <FieldFrom label="Teléfono" id="phone" tel placeholder="" />
      <FieldFrom label="Motivo" id="motive" motive placeholder="" />
      <FieldFrom
        label="Mensaje"
        id="message"
        placeholder="Ingrese su mensaje"
        textArea={true}
      />
      <button type="submit">
        Enviar <ChevronRight class="h-4" strokeWidth={1} />
      </button>
    </form>
    <div id="toast" class="toast hidden">
      ¡Gracias por contactarnos! Le responderemos a la brevedad
    </div>
  </div>
</section>

<script>
  const form = document.querySelector("form");
  const toast = document.querySelector("#toast");

  async function handleSubmit(event) {
    event.preventDefault();
    try {
      const formData = new FormData(event.target);
      const formValues = {};
      formData.forEach((value, key) => {
        formValues[key] = value;
      });
      console.log(formValues);
      const response = await fetch("/api/send-email", {
        method: "POST",
        body: formData,
      });

      if (response.ok) {
        toast.textContent = "¡Gracias por contactarnos! Le responderemos a la brevedad";
        toast.classList.remove("hidden");
        setTimeout(() => {
          toast.classList.add("hidden");
        }, 3000);
        form.reset();
      } else {
        toast.textContent = "Hubo un error al enviar el mensaje. Por favor, inténtelo de nuevo.";
        toast.classList.remove("hidden");
        setTimeout(() => {
          toast.classList.add("hidden");
        }, 3000);
      }
    } catch (error) {
      console.error("Error:", error);
      toast.textContent = "Hubo un error al enviar el mensaje. Por favor, inténtelo de nuevo.";
      toast.classList.remove("hidden");
      setTimeout(() => {
        toast.classList.add("hidden");
      }, 3000);
    }
  }

  form.addEventListener("submit", handleSubmit);
</script>

<style>
  .toast {
    visibility: hidden;
    min-width: 250px;
    margin-left: -125px;
    background-color: #333;
    color: #fff;
    text-align: center;
    border-radius: 2px;
    padding: 16px;
    position: fixed;
    z-index: 1;
    left: 50%;
    bottom: 30px;
  }
  .toast.hidden {
    visibility: hidden;
  }
  .toast:not(.hidden) {
    visibility: visible;
    -webkit-animation: fadein 0.5s, fadeout 0.5s 2.5s;
    animation: fadein 0.5s, fadeout 0.5s 2.5s;
  }
  @-webkit-keyframes fadein {
    from {
      bottom: 0;
      opacity: 0;
    }
    to {
      bottom: 30px;
      opacity: 1;
    }
  }
  @keyframes fadein {
    from {
      bottom: 0;
      opacity: 0;
    }
    to {
      bottom: 30px;
      opacity: 1;
    }
  }
  @-webkit-keyframes fadeout {
    from {
      bottom: 30px;
      opacity: 1;
    }
    to {
      bottom: 0;
      opacity: 0;
    }
  }
  @keyframes fadeout {
    from {
      bottom: 30px;
      opacity: 1;
    }
    to {
      bottom: 0;
      opacity: 0;
    }
  }
  button {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 25rem;
    border: none;
    background-color: #bef0bb;
    color: #366b33;
    font-weight: 700;
    font-size: 1rem;
    padding: 0.7rem 1.2rem;
    margin-top: 2rem;
    border-radius: 9999px;
  }
  @media (max-width: 768px) {
    button {
      width: 100%;
    }
  }
</style>