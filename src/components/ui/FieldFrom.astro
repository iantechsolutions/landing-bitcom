---
interface Props {
  label: string;
  placeholder: string;
  id: string;
  textArea?: boolean;
  tel?: boolean;
  motive?: boolean;
}
const { label, id, placeholder, textArea, tel, motive } = Astro.props;
---

<div
  class={`flex flex-col gap-2 items-start border-b-2 border-[#85CE81] px-0 my-4 pb-2 ${textArea ? "md:col-span-2" : ""}`}
>
  <label for={id} class="text-[#747474] text-left w-full">{label}</label>
  {
    textArea && (
      <textarea
        id={id}
        name={id}
        class="border-none bg-inherit focus:outline-none w-full h-14 truncate"
        placeholder={placeholder}
      />
    )
  }
  {
    tel && (
      <div class="flex gap-2 items-center pl-4">
        <select class="border-none bg-inherit focus:outline-none text-left truncate">
          <option value="phone" class="dark:bg-black">
            Telefono
          </option>
          <option value="cellphone" class="dark:bg-black">
            Celular
          </option>
        </select>
        <input
          type="tel"
          placeholder="ej: 11 1234 5678"
          id={id}
          name={id}
          class="border-none bg-inherit focus:outline-none truncate"
        />
      </div>
    )
  }
  {
    motive && (
      <select
        id={id}
        name={id}
        class="pl-4 border-none bg-inherit focus:outline-none w-full truncate"
      >
        <option value="consulta" class="dark:bg-black">
          Consulta
        </option>
        <option value="reclamo" class="dark:bg-black">
          Reclamo
        </option>
        <option value="sugerencia" class="dark:bg-black">
          Sugerencia
        </option>
      </select>
    )
  }
  {
    !textArea && !tel && !motive && (
      <input
        type="text"
        id={id}
        name={id}
        class="pl-4 border-none bg-inherit focus:outline-none w-full truncate"
        placeholder={placeholder}
        required
      />
    )
  }
</div>

<style>
  input:-webkit-autofill,
  input:-webkit-autofill:focus {
    transition:
      background-color 600000s 0s,
      color 600000s 0s;
  }
  input[data-autocompleted] {
    background-color: transparent !important;
  }
  textarea {
    resize: none;
    height: 2rem;
    overflow-y: auto;
  }
</style>
